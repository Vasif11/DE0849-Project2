# Secrets and private keys (never commit) -- required by the guidebook
deploy/.env
.env
secrets/
pki/ca.key
pki/*.srl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Large datasets and raw captures (kept local)
ids-dataset/raw/
ids-dataset/data/iscx_flows.csv
*.rar

# per-run archive copy is redundant with the committed security/ evidence
ci-artifacts/

# ZAP writes a large session DB next to the reports
security/reports/zap/**/*.session*
security/reports/zap/**/*.session

# build artifacts
*.log
